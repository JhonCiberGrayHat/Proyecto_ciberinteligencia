{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IDS: entrenar multiclase (datos descargados)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ids.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["entrenar", "--mode", "multiclase"]
    },
    {
      "name": "IDS: descargar datos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ids.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["descargar"]
    }
  ]
}
